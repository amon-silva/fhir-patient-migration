# Copy to .env for local development (`cp .env.example .env`). .env is git-ignored.
# Variables already set in the system environment take precedence over this file.

# dev (default) or prod. prod turns off the browsable API.
ENVIRONMENT=dev

# Never point this at a server that holds real patient data.
# FHIR_BASE_URL=https://hapi.fhir.org/baseR4
